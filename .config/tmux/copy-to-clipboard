#!/usr/bin/env python3
"""Send one OSC 52 clipboard write to the attached tmux client."""
import base64
import os
import re
import sys

if len(sys.argv) != 2 or not re.fullmatch(r"/dev/pts/[0-9]+", sys.argv[1]):
    raise SystemExit(2)
content = sys.stdin.buffer.read()
if not content:
    raise SystemExit(0)
packet = b"\x1b]52;c;" + base64.b64encode(content) + b"\x07"
fd = os.open(sys.argv[1], os.O_WRONLY | os.O_NOCTTY)
try:
    offset = 0
    while offset < len(packet):
        offset += os.write(fd, packet[offset:])
finally:
    os.close(fd)
